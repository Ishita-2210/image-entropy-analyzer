# Copy values into your shell or use uvicorn --env-file with python-dotenv installed.
IEA_HISTORY=false
IEA_HISTORY_PATH=.runtime/history.sqlite3
IEA_MAX_UPLOAD_MB=24
IEA_MAX_PIXELS=16000000
IEA_MAX_ANALYSIS_PIXELS=4000000
IEA_STORE_MB=192
IEA_WORKERS=2
IEA_MAX_JOBS=10
IEA_JOB_SECONDS=120
IEA_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
IEA_HOSTS=localhost,127.0.0.1
